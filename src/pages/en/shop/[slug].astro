---
import Base from '../../../layouts/Base.astro';
import Contact from '../../../components/Contact.astro';
import { t, localePath } from '../../../i18n';
import { PRODUCTS, productName } from '../../../data/products';
import { SITE } from '../../../data/site';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;
const locale = 'en' as const;
const dict = t(locale);
const name = productName(product, locale);
const sold = product.status === 'sold_out';
const fmt = (n: number) => new Intl.NumberFormat('en-US').format(n);
const waMsg = `Hi, I'm interested in "${name}".`;
const waHref = `${SITE.whatsappUrl}?text=${encodeURIComponent(waMsg)}`;
---
<Base locale={locale} pageKey="product" titleOverride={`${name} · ${dict.shop.title}`}>
  <section class="relative bg-[var(--color-bg)] pt-28 sm:pt-32 pb-20 sm:pb-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <a href={localePath(locale, 'shop')} class="reveal inline-flex items-center text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors mb-8">
        {dict.shop.back}
      </a>
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-14 items-start">
        <div class="reveal">
          <figure class="relative aspect-[4/3] lg:aspect-square overflow-hidden rounded-sm bg-[var(--color-bg-elevated)] border border-[var(--color-border)]">
            <picture>
              <source srcset={`${product.images[0]}.webp`} type="image/webp" data-hero-source />
              <img src={`${product.images[0]}.jpg`} alt={name} class={`w-full h-full object-cover ${sold ? 'grayscale opacity-70' : ''}`} loading="eager" decoding="async" data-hero-img />
            </picture>
            {sold && (
              <span class="absolute top-4 left-4 text-xs font-semibold uppercase tracking-widest bg-[var(--color-red)] text-white px-3 py-1 rounded-sm">{dict.shop.sold_out}</span>
            )}
          </figure>

          {product.images.length > 1 && (
            <div class="mt-3 grid grid-cols-4 gap-2 sm:gap-3" data-gallery>
              {product.images.map((img, i) => (
                <button
                  type="button"
                  data-thumb={`${img}`}
                  aria-label={`${name} ${i + 1}`}
                  class={`relative aspect-square overflow-hidden rounded-sm border transition-colors ${i === 0 ? 'border-[var(--color-accent)]' : 'border-[var(--color-border)] hover:border-[var(--color-text-muted)]'}`}
                >
                  <picture>
                    <source srcset={`${img}.webp`} type="image/webp" />
                    <img src={`${img}.jpg`} alt="" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                  </picture>
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="reveal" style="transition-delay: 100ms">
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[var(--color-accent)] mb-3">{dict.shop.product_label}</p>
          <h1 class="font-display text-3xl sm:text-5xl text-white leading-tight">{name}</h1>
          <p class="mt-5 text-base text-[var(--color-text)]/85">{product.blurb[locale]}</p>

          {product.description && (
            <div class="mt-5 space-y-3 text-sm sm:text-base text-[var(--color-text)]/75 leading-relaxed">
              {product.description[locale].map((para) => <p>{para}</p>)}
            </div>
          )}

          {product.variants ? (
            <dl class="mt-8 divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
              {product.variants.map((v) => (
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt class="text-sm sm:text-base text-[var(--color-text)]/85">{v.label[locale]}</dt>
                  <dd class="font-display text-2xl sm:text-3xl text-[var(--color-accent)] tabular-nums whitespace-nowrap">
                    {fmt(v.price)} <span class="text-sm uppercase tracking-wider text-[var(--color-text-muted)]">{dict.shop.currency}</span>
                  </dd>
                </div>
              ))}
            </dl>
          ) : product.price != null ? (
            <div class="mt-8 flex items-baseline gap-2">
              {product.priceFrom && <span class="text-sm uppercase tracking-wider text-[var(--color-text-muted)]">{dict.shop.from}</span>}
              <span class="font-display text-4xl sm:text-5xl text-[var(--color-accent)] tabular-nums">{fmt(product.price)}</span>
              <span class="text-base uppercase tracking-wider text-[var(--color-text-muted)]">{dict.shop.currency}</span>
            </div>
          ) : (
            <div class="mt-8">
              <span class="font-display text-2xl sm:text-3xl text-[var(--color-accent)]">{dict.shop.price_on_request}</span>
            </div>
          )}

          <a href={waHref} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold tracking-wide uppercase bg-[var(--color-accent)] text-black hover:bg-white transition-colors rounded-sm">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            {dict.shop.order_cta}
          </a>
        </div>
      </div>
    </div>
  </section>

  <Contact locale={locale} />

  <script is:inline>
    const gallery = document.querySelector('[data-gallery]');
    if (gallery) {
      const heroImg = document.querySelector('[data-hero-img]');
      const heroSource = document.querySelector('[data-hero-source]');
      gallery.querySelectorAll('[data-thumb]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const base = btn.getAttribute('data-thumb');
          heroImg.src = `${base}.jpg`;
          if (heroSource) heroSource.srcset = `${base}.webp`;
          gallery.querySelectorAll('[data-thumb]').forEach((b) => {
            b.classList.toggle('border-[var(--color-accent)]', b === btn);
            b.classList.toggle('border-[var(--color-border)]', b !== btn);
          });
        });
      });
    }
  </script>
</Base>
