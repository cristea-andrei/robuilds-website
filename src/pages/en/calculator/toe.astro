---
import Base from '../../../layouts/Base.astro';
import ToeCalculator from '../../../components/ToeCalculator.astro';
import { t } from '../../../i18n';

const locale = 'en' as const;
const dict = t(locale);
---
<Base locale={locale} pageKey="calculator" titleOverride={`${dict.toe.title} · ${dict.meta.title}`} descriptionOverride={dict.toe.body}>
  <ToeCalculator locale={locale} />
</Base>
