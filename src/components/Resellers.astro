---
import { t, type Locale } from '../i18n';
import { RESELLERS, telHref } from '../data/resellers';

const { locale } = Astro.props as { locale: Locale };
const dict = t(locale);
---
{RESELLERS.length > 0 && (
  <section id="resellers" class="relative bg-[var(--color-bg)] pb-16 sm:pb-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mb-6 sm:mb-8 max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[var(--color-accent)] mb-3">{dict.resellers.kicker}</p>
        <h2 class="font-display text-2xl sm:text-4xl text-white leading-tight">{dict.resellers.title}</h2>
        <p class="mt-3 text-sm sm:text-base text-[var(--color-text-muted)]">{dict.resellers.body}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        {RESELLERS.map((r) => (
          <article class="reveal flex flex-col sm:flex-row gap-5 sm:gap-6 bg-[var(--color-bg-elevated)] border border-[var(--color-border)] rounded-sm p-5 sm:p-6">
            <a href={r.url} target="_blank" rel="noopener" class="shrink-0 flex items-center justify-center w-full sm:w-40 h-24 bg-white/5 rounded-sm px-4" aria-label={r.name}>
              {r.logo
                ? <img src={r.logo} alt={r.name} class="max-h-16 max-w-full object-contain" loading="lazy" decoding="async" />
                : <span class="font-display text-2xl tracking-wider text-white uppercase">{r.name}</span>}
            </a>
            <div class="flex-1 min-w-0">
              <p class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-accent)]">
                {`${dict.resellers.official_for} ${r.country[locale]}`}
              </p>
              <h3 class="mt-1 font-display text-xl sm:text-2xl text-white leading-tight">{r.name}</h3>
              <ul class="mt-3 space-y-1 text-sm text-[var(--color-text-muted)]">
                <li>{r.address}</li>
                <li>
                  {r.phones.map((p, i) => (
                    <>{i > 0 && ' · '}<a href={telHref(p)} class="hover:text-[var(--color-accent)] transition-colors">{p}</a></>
                  ))}
                </li>
                <li><a href={`mailto:${r.email}`} class="hover:text-[var(--color-accent)] transition-colors">{r.email}</a></li>
              </ul>
              <a href={r.url} target="_blank" rel="noopener" class="mt-4 inline-flex items-center text-sm font-semibold text-[var(--color-accent)] hover:text-white transition-colors">
                {`${dict.resellers.visit} ${r.url.replace(/^https?:\/\//, '').replace(/\/$/, '')} →`}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
